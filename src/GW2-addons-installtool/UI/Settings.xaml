<Page x:Class="GW2_addons_installtool.UI.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Settings">
  <Grid Margin="20,10,20,15">
    <Grid.RowDefinitions>
      <!-- Header Row -->
      <RowDefinition Height="45" />
      <!-- Main Content Row -->
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header Area -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" PreviewMouseDown="TitleBar_MouseHeld">
        <TextBlock Text="激战2插件安装更新工具" FontSize="18" FontWeight="Bold" Foreground="#FF2D3748" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" />
        <TextBlock Text="永恒泰蜜的克鲁" FontSize="12" Foreground="#FF718096" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" Margin="10,2,0,0" />
        <Border CornerRadius="4" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" Margin="12,0,0,0" Padding="6,2" VerticalAlignment="Center">
          <TextBlock Name="label" Text="v3.3.2" FontSize="11" Foreground="#FF2B6CB0" FontWeight="Bold" />
        </Border>
        <StackPanel Name="updatePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center">
          <Border CornerRadius="4" Background="#FFF5F5" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Name="label1" Text="发现新版本!" FontSize="11" Foreground="#FFE53E3E" FontWeight="Bold" />
          </Border>
          <Button Name="update_self_button" Content="下载最新版" Margin="6,0,0,0" Padding="8,2" FontSize="11" Background="#FFE53E3E" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="update_self_click" />
        </StackPanel>
      </StackPanel>

      <!-- Window Minimize / Close Buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
        <Button Name="minimize" Content="─" Width="28" Height="24" Background="Transparent" Foreground="#FF718096" FontSize="12" BorderThickness="0" Click="minimize_clicked" />
        <Button Name="close" Content="✕" Width="28" Height="24" Background="Transparent" Foreground="#FF718096" FontSize="12" BorderThickness="0" Click="close_clicked" />
      </StackPanel>
    </Grid>

    <!-- Main Content Area -->
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="500" />
        <ColumnDefinition Width="15" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Settings Cards (Grid to stretch bottom card to match right column height) -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Card 1: 安装模式与滤镜配置 -->
        <Border Grid.Row="0" CornerRadius="8" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
          <StackPanel>
            <TextBlock Text="⚙️ 安装模式与滤镜配置" FontSize="13" FontWeight="Bold" Foreground="#FF2D3748" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              
              <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="安装模式:" FontSize="13" Foreground="#FF4A5568" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Name="nowinstallmodedesc" Text="Nexus模式" FontSize="13" Foreground="#FF2B6CB0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Name="installmodeMenuButton" Content="切换模式 ⇌" Padding="6,2" Background="#EDF2F7" Foreground="#FF2D3748" BorderBrush="#CBD5E0" BorderThickness="1" FontSize="12" FontWeight="Bold" Click="installmodeMenuButton_Click" />
                <Popup Name="installmodeMenuPopup" Placement="Bottom" StaysOpen="False">
                  <Border BorderBrush="#CBD5E0" BorderThickness="1" Background="White" CornerRadius="6" Padding="6">
                    <StackPanel Width="110">
                      <ToggleButton Name="BtnNexus" Content="Nexus模式" Margin="0,2" Height="28" Click="installmode_Click" />
                      <ToggleButton Name="BtnNormal" Content="正常模式" Margin="0,2" Height="28" Click="installmode_Click" />
                      <ToggleButton Name="BtnTrouble" Content="疑难模式" Margin="0,2" Height="28" Click="installmode_Click" />
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ReShade:" FontSize="13" Foreground="#FF4A5568" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton Name="BtnReShadeMode1" Content="模式一" Padding="6,2" Margin="0,0,4,0" Click="ReShadeMode_Click" />
                <ToggleButton Name="BtnReShadeMode2" Content="模式二" Padding="6,2" Click="ReShadeMode_Click" />
              </StackPanel>
            </Grid>

            <!-- DPS Version & Font Size Row -->
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              
              <!-- DPS Version -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DPS版本:" FontSize="13" Foreground="#FF4A5568" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Name="ArcdpslistComboBox" DisplayMemberPath="DisplayText" Width="170" FontSize="12" SelectionChanged="ArcdpslistComboBox_SelectionChanged" />
              </StackPanel>

              <!-- Font Size -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="字体大小:" FontSize="13" Foreground="#FF4A5568" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider Name="fontSizeSlider" Width="80" Minimum="13" Maximum="24" SmallChange="1" TickPlacement="None" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="fontSizeSlider_ValueChanged" />
                <TextBlock Name="fontSizeValueLabel" Text="{Binding Value, ElementName=fontSizeSlider}" FontSize="13" FontWeight="Bold" Foreground="#FF2D3748" VerticalAlignment="Center" Margin="4,0,0,0" Width="18" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Card 2: 维护与工具 -->
        <Border Grid.Row="2" CornerRadius="8" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
          <StackPanel>
            <TextBlock Text="🛠️ 维护与工具" FontSize="13" FontWeight="Bold" Foreground="#FF2D3748" Margin="0,0,10,10" />
            <UniformGrid Columns="3">
              <Button Content="恢复默认标题栏" Height="30" Margin="0,0,6,0" Background="#EDF2F7" Foreground="#FF2D3748" BorderBrush="#CBD5E0" BorderThickness="1" FontWeight="Bold" FontSize="12" Click="RecoverDT_button_Click" />
              <Button Content="卸载已安装插件" Height="30" Margin="0,0,6,0" Background="#FFF5F5" Foreground="#FFE53E3E" BorderBrush="#FEB2B2" BorderThickness="1" FontWeight="Bold" FontSize="12" Click="uninstall_clicked_Click" />
              <Button Content="删除配置文件" Height="30" Background="#FFF5F5" Foreground="#FFE53E3E" BorderBrush="#FEB2B2" BorderThickness="1" FontWeight="Bold" FontSize="12" Click="uninstall_config_Click" />
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Card 3: 激战2游戏根目录 (VerticalAlignment="Stretch" to perfectly match right column bottom) -->
        <Border Grid.Row="4" CornerRadius="8" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" VerticalAlignment="Stretch">
          <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="📁 激战2游戏根目录" FontSize="13" FontWeight="Bold" Foreground="#FF2D3748" />
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBox Name="labebox1" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="6,0" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" IsReadOnly="True" />
              <Button Name="nextPage_Copy1" Grid.Column="1" Content="选择游戏目录" Height="32" Margin="8,0,0,0" Background="#3182CE" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="12" Click="getpatch_button_clicked" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Right Column: Addon Checklist & Big Install Button (VerticalAlignment="Stretch") -->
      <Border Grid.Column="2" CornerRadius="8" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="📦 选择安装插件" FontSize="13" FontWeight="Bold" Foreground="#FF2D3748" Margin="4,0,0,8" />

          <ListBox Name="addons" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="addOnList_SelectedIndexChanged">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2,3">
                  <CheckBox Name="TheCheckBox" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="addonschanged" Margin="0,0,6,0" />
                  <TextBlock Name="add_name" VerticalAlignment="Center" FontSize="13" Foreground="#FF2D3748" FontWeight="Bold" Text="{Binding Addon_name}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>

          <Button Name="nextPage" Grid.Row="2" Content="🚀 一键安装 / 更新插件" Height="40" Margin="0,8,0,0" Background="#38A169" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Click="update_button_clicked" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
