<Page x:Class="GW2_addons_installtool.UI.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Settings">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Window Controls -->
    <DockPanel Name="windowControls" Dock="Top" VerticalAlignment="Center" Height="63">
      <Button Name="close" Content="x" Width="25" Height="25" DockPanel.Dock="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,8,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="close_clicked" />
      <Button Name="minimize" Content="-" Width="25" Height="25" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,0,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="minimize_clicked" />
      <Label Content="" PreviewMouseDown="TitleBar_MouseHeld" />
    </DockPanel>

    <!-- App Title & Version -->
    <Label FontWeight="Bold" FontSize="30" Foreground="#FF696969" Margin="45,35,0,0" FontFamily="Microsoft YaHei UI" Width="225" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Content="永恒泰蜜的克鲁" Grid.RowSpan="3" />
    <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="3" Margin="60,80,0,0" Height="25" Width="175" FontSize="16" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" Text="激战2插件安装更新工具" />

    <Label Name="label" Content="工具版本: v3.2.6" HorizontalAlignment="Left" Foreground="#FF696969" Margin="50,5,0,0" Grid.Row="0" VerticalAlignment="Top" Width="220" />
    <Label Name="label1" Content="New!" HorizontalAlignment="Left" Foreground="#FF696969" Margin="150,5,0,0" Grid.Row="0" VerticalAlignment="Top" Width="65" />
    <Label Name="label2" Content="" HorizontalAlignment="Left" Foreground="#FF696969" Margin="50,20,0,0" Grid.Row="0" VerticalAlignment="Top" Width="225" />
    <Button Name="update_self_button" Grid.Row="0" Margin="190,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="20" Content="更新" Background="#00FFFFFF" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" BorderBrush="#FF696969" BorderThickness="1" Click="update_self_click" />
    <ProgressBar Name="jindu" HorizontalAlignment="Left" Height="10" Margin="55,28,0,0" Grid.Row="0" VerticalAlignment="Top" Width="200" />

    <!-- Addon Selection List (Right Side) -->
    <Border Grid.Row="0" Grid.RowSpan="3" Width="200" HorizontalAlignment="Left" Margin="560,50,0,31" BorderThickness="1" BorderBrush="#FF696969" Background="#FFF5F5F5">
      <StackPanel Width="200" Height="313" HorizontalAlignment="Left">
        <Label FontSize="15" FontFamily="Microsoft YaHei UI" Margin="0,0,0,0" HorizontalAlignment="Center" Foreground="#FF696969" Content="选择插件" FontWeight="Bold" />
        <ListBox Name="addons" Height="285" ItemContainerStyle="{StaticResource AddonListItem}" BorderThickness="0" Background="#FFF5F5F5" Style="{DynamicResource ScrollableAddonListBox}" SelectionChanged="addOnList_SelectedIndexChanged">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <CheckBox Name="TheCheckBox" Padding="5,5,0,5" VerticalAlignment="Center" FontFamily="Microsoft YaHei" FontWeight="Bold" Foreground="#FF696969" FontSize="13" Width="20" Style="{StaticResource AddonListCheckBox}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="addonschanged" />
                <Label Name="add_name" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" Foreground="#FF696969" FontWeight="Bold" FontSize="13" Content="{Binding Addon_name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- DPS Version Selection -->
    <Border Name="label_versions" Grid.Row="2" Width="165" HorizontalAlignment="Left" Margin="265,15,0,265" BorderThickness="1" BorderBrush="#FF696969" Background="#FFF5F5F5">
      <StackPanel Width="165" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Label Name="labe1" Content="选择DPS版本" HorizontalAlignment="Center" Foreground="#FF696969" VerticalAlignment="Top" />
        <Button Name="installdpsmodeMenuButton" Margin="141,-25,0,0" Content="⇌" Width="22" Height="22" Background="#FFF5F5F5" Foreground="#FF696969" BorderBrush="#FFF5F5F5" BorderThickness="0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="installdpsmode_Click" />
        <ComboBox Name="ArcdpslistComboBox" HorizontalAlignment="Left" Margin="1,0,0,0" VerticalAlignment="Top" Width="161" FontSize="12" MaxDropDownHeight="195" SelectionChanged="ArcdpslistComboBox_SelectionChanged">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="0,0,0,0" Width="131">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} {1}">
                    <Binding Path="dps_descr" />
                    <Binding Path="dps_name" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
        <Border Name="tuijiandps" Width="161" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,-21,0,0" BorderThickness="1" BorderBrush="#FFACACAC" Background="#FFF5F5F5">
          <StackPanel Width="161" HorizontalAlignment="Left">
            <Label Name="labe1_1" Margin="0,-3,0,0" Content="" HorizontalAlignment="Left" Foreground="#FF696969" VerticalAlignment="Top" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Installation Mode Selection Button -->
    <Grid Name="MenuPopupinstallmode" Grid.Row="2" Margin="265,75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal">
        <Label Name="nowinstallmodedesc" Content="模式: Nexus模式" Foreground="#FF696969" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
        <Button Name="installmodeMenuButton" Content="切换模式 ⇌" Width="90" Height="26" Background="#7FABEFF9" Foreground="#FF0AE417" BorderBrush="#FFC9C9C9" BorderThickness="1" FontFamily="Microsoft YaHei UI" FontWeight="Bold" FontSize="12" Click="installmodeMenuButton_Click" Margin="10,0,0,0" />
      </StackPanel>
      <Popup Name="installmodeMenuPopup" Placement="Bottom" HorizontalOffset="0" VerticalOffset="0" StaysOpen="False">
        <Border BorderBrush="#FFC9C9C9" BorderThickness="1" Background="#FCFCFC" Padding="10">
          <StackPanel>
            <TextBlock Text="安装模式选择" HorizontalAlignment="Center" Foreground="#FF696969" Margin="0,0,0,5" FontWeight="Bold" />
            <Border CornerRadius="20" Background="#ebecf0" Padding="0" Margin="0,4,0,0" Height="32" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid Margin="2,0">
                <ToggleButton Name="BtnNexus" Content="Nexus模式" Style="{StaticResource installClickButton}" Click="installmode_Click" />
              </Grid>
            </Border>
            <Border CornerRadius="20" Background="#ebecf0" Padding="0" Margin="0,4,0,0" Height="32" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid Margin="2,0">
                <ToggleButton Name="BtnNormal" Content="正常模式" Style="{StaticResource installClickButton}" Click="installmode_Click" />
              </Grid>
            </Border>
            <Border CornerRadius="20" Background="#ebecf0" Padding="0" Margin="0,4,0,0" Height="32" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid Margin="2,0">
                <ToggleButton Name="BtnTrouble" Content="疑难模式" Style="{StaticResource installClickButton}" Click="installmode_Click" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- ARCDPS Font Size Control (Moved to Main Screen) -->
    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="265,115,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Label Content="ARCDPS 字体大小:" Foreground="#FF696969" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Padding="0" />
      <Slider Name="fontSizeSlider" Width="100" Minimum="13" Maximum="24" SmallChange="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0,5,0" ValueChanged="fontSizeSlider_ValueChanged" />
      <Label Name="fontSizeValueLabel" Content="{Binding Value, ElementName=fontSizeSlider}" Foreground="#FF696969" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Padding="0" />
    </StackPanel>

    <!-- Maintenance Action Buttons (Moved to Main Screen) -->
    <StackPanel Grid.Row="2" Margin="265,145,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Button Content="恢复默认标题栏" Width="145" Height="26" Margin="0,0,0,5" Foreground="#FF0AE417" Background="#7FABEFF9" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Bold" BorderThickness="1" BorderBrush="#FFC9C9C9" Style="{StaticResource BigContentButton}" Click="RecoverDT_button_Click" />
      <Button Content="卸载已安装插件" Width="145" Height="26" Margin="0,0,0,5" Foreground="#FFF50404" Background="#FFFFEBEB" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Bold" BorderThickness="1" BorderBrush="#FFFFC1C1" Style="{StaticResource BigContentButton}" Click="uninstall_clicked_Click" />
      <Button Content="删除插件配置文件" Width="145" Height="26" Margin="0,0,0,0" Foreground="#FFF50404" Background="#FFFFEBEB" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Bold" BorderThickness="1" BorderBrush="#FFFFC1C1" Style="{StaticResource BigContentButton}" Click="uninstall_config_Click" />
    </StackPanel>

    <!-- ReShade Filter Mode Toggles -->
    <Border Grid.Row="2" CornerRadius="20" Background="#ebecf0" Padding="0" Margin="438,-5,0,0" Height="32" Width="110" VerticalAlignment="Top" HorizontalAlignment="Left">
      <Grid Margin="2,0">
        <ToggleButton Name="BtnReShadeMode1" Content="滤镜模式一" Style="{StaticResource installClickButton}" Click="ReShadeMode_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="2" CornerRadius="20" Background="#ebecf0" Padding="0" Margin="438,40,0,0" Height="32" Width="110" VerticalAlignment="Top" HorizontalAlignment="Left">
      <Grid Margin="2,0">
        <ToggleButton Name="BtnReShadeMode2" Content="滤镜模式二" Style="{StaticResource installClickButton}" Click="ReShadeMode_Click" />
      </Grid>
    </Border>

    <!-- Game Path Input -->
    <TextBlock Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,370,0,0" FontFamily="Microsoft YaHei UI Light" Foreground="#FF696969" FontSize="14" Text="游戏路径" />
    <TextBox Name="labebox1" Text="" Grid.Row="3" Margin="44,-3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="505" Height="23" Background="#FFD3D3D3" BorderThickness="0" FontSize="16" FontFamily="Microsoft YaHei UI Light" />

    <!-- Bottom Action Buttons -->
    <Button Name="nextPage_Copy1" Grid.Row="3" Content="选择激战2游戏目录" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="560,-20,0,0" Width="200" Height="40" Foreground="#FF0AE417" Background="#7FABEFF9" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" Padding="2" BorderBrush="#FFC9C9C9" Style="{StaticResource BigContentButton}" FontWeight="Bold" Click="getpatch_button_clicked" />
    <Button Name="nextPage" Grid.Row="3" Content="安装/更新插件" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="560,30,0,0" Width="200" Height="40" Foreground="#FF0AE417" Background="#7FABEFF9" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" Padding="2" BorderBrush="#FFC9C9C9" Style="{StaticResource BigContentButton}" FontWeight="Bold" Click="update_button_clicked" />
  </Grid>
</Page>
