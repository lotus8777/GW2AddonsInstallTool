<Page x:Class="GW2_addons_installtool.UI.Options"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Options">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Name="windowControls" Dock="Top" VerticalAlignment="Center" Height="63">
      <Button Name="close" Content="x" Width="25" Height="25" DockPanel.Dock="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,8,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="close_clicked" />
      <Button Name="minimize" Content="-" Width="25" Height="25" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,0,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="minimize_clicked" />
      <Label Content="" PreviewMouseDown="TitleBar_MouseHeld" />
    </DockPanel>
    <Label FontWeight="Bold" FontSize="30" Foreground="#FF696969" Margin="45,35,0,0" FontFamily="Microsoft YaHei UI" Width="225" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Content="永恒泰蜜的克鲁" Grid.RowSpan="4" />
    <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="4" Margin="60,80,0,0" Height="25" Width="175" FontSize="16" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" Text="激战2插件安装更新工具" />
    <Button Name="back" HorizontalAlignment="Left" Height="40" Width="55" Content="返回" Margin="705,313,0,2" Foreground="#FFFFFFFF" Background="#FF696969" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" BorderBrush="#FF6E6E6E" Style="{StaticResource BigContentButton}" FontWeight="Bold" Grid.Row="3" Click="back_clicked" />
    <Button Name="nextPage_Copy1" Grid.Row="3" Content="选择激战2游戏目录" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,93,193" Foreground="#FF0AE417" Background="#7FABEFF9" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" Padding="2" BorderBrush="#FFC9C9C9" Style="{StaticResource BigContentButton}" FontWeight="Bold" Click="getpatch_button_clicked" />
    <Label Name="label1" Content="DPS插件设置:" HorizontalAlignment="Left" Margin="505,180,0,0" Grid.Row="3" VerticalAlignment="Top" />
    <Label Name="label2" Content="字体大小:" HorizontalAlignment="Left" Margin="505,223,0,0" Grid.Row="3" VerticalAlignment="Top" />
    <Label Name="label2_1" HorizontalAlignment="Left" Margin="560,223,0,0" Grid.Row="3" VerticalAlignment="Top" Content="{Binding Value, ElementName=slider}" />
    <Label Name="label2_2" Content="(安装完成后设置)" HorizontalAlignment="Left" Margin="688,223,0,0" Grid.Row="3" VerticalAlignment="Top" />
    <Slider Name="slider" HorizontalAlignment="Left" Margin="588,223,0,0" Grid.Row="3" VerticalAlignment="Top" Width="97" Minimum="13" Maximum="24" SmallChange="1" TickPlacement="TopLeft" IsSnapToTickEnabled="True" ValueChanged="slider_valueCG" />
    <TextBox Name="textBox" HorizontalAlignment="Left" Margin="505,75,0,0" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="258" Height="50" />
    <Label Name="label" Content="Label" HorizontalAlignment="Left" Margin="597,40,0,0" Grid.Row="3" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FlowDirection="RightToLeft" />
    <Button Name="back_Copy" HorizontalAlignment="Left" Height="40" Width="135" Content="卸载插件" Margin="560,313,0,2" Foreground="#FFF50404" Background="#FF14D277" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" BorderBrush="#FF6E6E6E" Style="{StaticResource BigContentButton}" FontWeight="Bold" Grid.Row="3" Click="uninstall_clicked" />
    <Button Name="back_Copy1" HorizontalAlignment="Left" Height="40" Width="135" Content="删除配置文件" Margin="415,313,0,2" Foreground="#FFF50404" Background="#FF14D277" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" BorderBrush="#FF6E6E6E" Style="{StaticResource BigContentButton}" FontWeight="Bold" Grid.Row="3" Click="uninstall_clicked1" />
    <Label Name="label3" Content="QQ群" HorizontalAlignment="Left" Margin="255,92,0,0" Grid.Row="3" VerticalAlignment="Top" />
    <Border Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="303,75,0,0" BorderThickness="1" BorderBrush="#FF696969" Background="#FFF5F5F5">
      <StackPanel HorizontalAlignment="Left">
        <Label Name="label4" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" />
      </StackPanel>
    </Border>
    <Button Name="Recover_DPStitle" Grid.Row="3" Content="恢复默认标题栏" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,118,152" Foreground="#FF0AE417" Background="#7FABEFF9" FontFamily="Microsoft YaHei UI" FontSize="12" BorderThickness="1" Padding="2" BorderBrush="#FFC9C9C9" Style="{StaticResource BigContentButton}" FontWeight="Bold" Click="RecoverDT_button" />
  </Grid>
</Page>
