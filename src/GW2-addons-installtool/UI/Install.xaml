<Page x:Class="GW2_addons_installtool.UI.Install"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Install" Loaded="ispageloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Name="windowControls" Dock="Top" VerticalAlignment="Center" Height="63">
      <Button Name="close" Content="x" Width="25" Height="25" DockPanel.Dock="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,8,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="close_clicked" />
      <Button Name="minimize" Content="-" Width="25" Height="25" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,0,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="minimize_clicked" />
      <Label Content="" PreviewMouseDown="TitleBar_MouseHeld" />
    </DockPanel>
    <Label FontWeight="Bold" FontSize="30" Foreground="#FF696969" Margin="268,37,0,304" FontFamily="Microsoft YaHei UI" Width="132" HorizontalAlignment="Left" Content="感谢使用" Grid.RowSpan="3" />
    <TextBlock Grid.Row="2" Margin="237,19,369,291" FontSize="16" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" Text="您的支持是对我最大的鼓励" />
    <TextBlock Grid.Row="2" Margin="304,44,0,0" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" Text="支付宝打赏" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <Image Name="image" Grid.Row="2" HorizontalAlignment="Left" Height="194" Margin="237,65,0,0" VerticalAlignment="Top" Width="190" Source="/resources/zfb.png" />
    <ProgressBar Name="jindu" HorizontalAlignment="Left" Height="10" Margin="172,20,0,0" Grid.Row="3" VerticalAlignment="Top" Width="424" />
    <Button Name="back" Height="45" Width="120" Content="返回" Margin="619,320,61,-10" Foreground="#FFFFFFFF" Background="#FF696969" FontFamily="Microsoft YaHei UI" FontSize="16" BorderThickness="1" BorderBrush="#FF6E6E6E" Style="{StaticResource BigContentButton}" FontWeight="Bold" Grid.Row="2" Grid.RowSpan="2" Click="back_clicked" />
    <TextBox Name="textBox" HorizontalAlignment="Left" Height="309" Margin="453,5,0,0" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="286" FontSize="10" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" UseLayoutRounding="True" />
    <Label Name="label" Content="" HorizontalAlignment="Left" Height="27" Margin="344,323,0,0" Grid.Row="2" VerticalAlignment="Top" Width="252" Grid.RowSpan="2" />
  </Grid>
</Page>
