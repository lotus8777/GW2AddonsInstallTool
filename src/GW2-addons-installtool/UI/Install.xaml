<Page x:Class="GW2_addons_installtool.UI.Install"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Install" Loaded="ispageloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Window Controls Bar -->
    <DockPanel Name="windowControls" Dock="Top" VerticalAlignment="Center" Height="63">
      <Button Name="close" Content="x" Width="25" Height="25" DockPanel.Dock="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,8,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="close_clicked" />
      <Button Name="minimize" Content="-" Width="25" Height="25" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#00FFFFFF" Foreground="#FF42FF00" FontSize="16" Margin="0,0,0,38" BorderThickness="0" FontFamily="Leelawadee UI" Click="minimize_clicked" />
      <Label Content="" PreviewMouseDown="TitleBar_MouseHeld" />
    </DockPanel>

    <!-- Header Titles -->
    <Label FontWeight="Bold" FontSize="26" Foreground="#FF696969" Margin="45,25,0,0" FontFamily="Microsoft YaHei UI" Width="300" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Content="插件安装与更新" Grid.RowSpan="3" />
    <TextBlock Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="3" Margin="47,65,0,0" Height="25" Width="250" FontSize="14" Foreground="#FF696969" FontFamily="Microsoft YaHei UI Light" Text="运行日志与安装进度" />

    <!-- Main Installation Output Text Box -->
    <TextBox Name="textBox" HorizontalAlignment="Left" Height="255" Margin="45,95,0,0" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="710" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFF8F9FA" BorderBrush="#FF696969" BorderThickness="1" Padding="5" />

    <!-- Progress Bar & Status -->
    <Label Name="label" Content="准备中..." HorizontalAlignment="Left" Height="25" Margin="45,355,0,0" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Top" Width="550" Foreground="#FF42FF00" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" />
    <ProgressBar Name="jindu" HorizontalAlignment="Left" Height="14" Margin="45,385,0,0" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Top" Width="550" Background="#FFE0E0E0" Foreground="#FF0AE417" />

    <!-- Back Button -->
    <Button Name="back" Height="38" Width="135" Content="返回主界面" Margin="620,365,0,0" Foreground="#FFFFFFFF" Background="#FF696969" FontFamily="Microsoft YaHei UI" FontSize="15" BorderThickness="1" BorderBrush="#FF6E6E6E" Style="{StaticResource BigContentButton}" FontWeight="Bold" Grid.Row="2" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Click="back_clicked" />
  </Grid>
</Page>
