<Page x:Class="GW2_addons_installtool.UI.Install"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GW2_addons_installtool.UI"
      ShowsNavigationUI="False" Title="Install" Loaded="ispageloaded">
  <Grid Margin="20,10,20,15">
    <Grid.RowDefinitions>
      <!-- Header Row -->
      <RowDefinition Height="45" />
      <!-- Main Content / Log Row -->
      <RowDefinition Height="*" />
      <!-- Bottom Progress & Action Row -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Area -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" PreviewMouseDown="TitleBar_MouseHeld">
        <TextBlock Text="插件安装与更新" FontSize="18" FontWeight="Bold" Foreground="#FF2D3748" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" />
        <TextBlock Text="运行日志与安装进度" FontSize="12" Foreground="#FF718096" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" Margin="10,2,0,0" />
      </StackPanel>

      <!-- Window Minimize / Close Buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Name="minimize" Content="─" Width="28" Height="24" Background="Transparent" Foreground="#FF718096" FontSize="12" BorderThickness="0" Click="minimize_clicked" />
        <Button Name="close" Content="✕" Width="28" Height="24" Background="Transparent" Foreground="#FF718096" FontSize="12" BorderThickness="0" Click="close_clicked" />
      </StackPanel>
    </Grid>

    <!-- Main Installation Output Text Box (Fills remaining height) -->
    <Border Grid.Row="1" CornerRadius="8" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,8,0,0">
      <TextBox Name="textBox" TextWrapping="Wrap" Text="" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FontSize="12.5" FontFamily="Consolas, Microsoft YaHei UI" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8" IsReadOnly="True" />
    </Border>

    <!-- Bottom Progress & Back Button Row -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>

      <!-- Progress Information & Bar -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
        <Label Name="label" Content="准备中..." Foreground="#FF2F855A" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Padding="0" Margin="0,0,0,4" />
        <ProgressBar Name="jindu" Height="12" Background="#EDF2F7" Foreground="#FF38A169" BorderThickness="0" />
      </StackPanel>

      <!-- Back Button -->
      <Button Name="back" Grid.Column="1" Height="36" Width="130" Content="返回主界面" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" Background="#FF4A5568" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" BorderThickness="0" Click="back_clicked" />
    </Grid>
  </Grid>
</Page>
